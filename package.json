{
  "name": "@abrar225/skills",
  "version": "0.0.1",
  "description": "SkillKit: a curated, source-traceable library of agent skills and developer resources",
  "main": "bin/vibe-skills.js",
  "bin": {
    "vibe-skills": "./bin/vibe-skills.js",
    "skillkit": "./bin/vibe-skills.js"
  },
  "scripts": {
    "build:registry": "python3 scripts/build-registry.py",
    "repair:sources": "python3 scripts/repair-source-descriptions.py",
    "repair:sources:check": "python3 scripts/repair-source-descriptions.py --check",
    "docs": "node scripts/build-docs.js",
    "validate": "node scripts/validate-registry.js",
    "test": "npm run validate && node --test tests/*.test.cjs && python3 -B -m unittest discover -s tests -p \"test_*.py\"",
    "list": "node bin/vibe-skills.js list",
    "search": "node bin/vibe-skills.js search",
    "scan": "node bin/vibe-skills.js scan",
    "export:all": "node bin/vibe-skills.js export --target agents --all",
    "export:antigravity": "node bin/vibe-skills.js export --target antigravity",
    "export:claude": "node bin/vibe-skills.js export --target claude",
    "export:cursor": "node bin/vibe-skills.js export --target cursor",
    "verify:upstream": "python3 scripts/import-skills.py --check",
    "serve": "node bin/http-server.js",
    "bench": "node bench/review.mjs",
    "gat": "node bench/gat/run.mjs"
  },
  "keywords": [
    "ai-agent",
    "agent-skills",
    "vibe-coding",
    "antigravity",
    "claude-code",
    "cursor",
    "monorepo",
    "orchestrator",
    "gravitas"
  ],
  "author": "Abrar Akhunji <abrarakhunji@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrar225/SkillKit.git"
  },
  "bugs": {
    "url": "https://github.com/abrar225/SkillKit/issues"
  },
  "homepage": "https://github.com/abrar225/SkillKit#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tar": "^7.5.23"
  }
}
