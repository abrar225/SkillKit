argin: 0 auto;\n      padding: 1.5rem;\n      background: #f5f5f4;\n      border-top: 3px solid #1c1917;\n      border-bottom: 1px solid #d6d3d1;\n      color: #1c1917;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.5;\n    }\n    .bookshop-grid-83 h2 {\n      margin: 0 0 0.375rem;\n      font-size: 1.25rem;\n      font-weight: 700;\n      color: #1c1917;\n    }\n    .bookshop-grid-83 .lead {\n      margin: 0 0 1.25rem;\n      font-size: 0.9375rem;\n      color: #44403c;\n    }\n    .bookshop-grid-83 .row {\n      display: grid;\n      gap: 1rem;\n      margin-bottom: 1rem;\n    }\n    @media (min-width: 36rem) {\n      .bookshop-grid-83 .row {\n        grid-template-columns: 1.2fr 1fr;\n      }\n    }\n    .bookshop-grid-83 .field {\n      margin-bottom: 1rem;\n    }\n    .bookshop-grid-83 .row .field {\n      margin-bottom: 0;\n    }\n    .bookshop-grid-83 label {\n      display: block;\n      margin-bottom: 0.375rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #292524;\n    }\n    .bookshop-grid-83 input,\n    .bookshop-grid-83 textarea {\n      display: block;\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.5rem 0.75rem;\n      box-sizing: border-box;\n      border: 1px solid #78716c;\n      border-radius: 0.25rem;\n      background: #ffffff;\n      color: #1c1917;\n      font: inherit;\n      font-size: 1rem;\n    }\n    .bookshop-grid-83 textarea {\n      min-height: 4.5rem;\n      resize: vertical;\n    }\n    .bookshop-grid-83 input:focus-visible,\n    .bookshop-grid-83 textarea:focus-visible,\n    .bookshop-grid-83 button:focus-visible {\n      outline: 2px solid #1c1917;\n      outline-offset: 2px;\n    }\n    .bookshop-grid-83 .hint {\n      margin: 0.375rem 0 0;\n      font-size: 0.8125rem;\n      color: #57534e;\n    }\n    .bookshop-grid-83 .footer {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1rem;\n      margin-top: 1.25rem;\n      padding-top: 1rem;\n      border-top: 1px solid #d6d3d1;\n    }\n    .bookshop-grid-83 .status {\n      margin: 0;\n      font-size: 0.875rem;\n      color: #44403c;\n    }\n    .bookshop-grid-83 button[type=\"submit\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1.5rem;\n      border: 1px solid #1c1917;\n      border-radius: 0.25rem;\n      background: #1c1917;\n      color: #ffffff;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n  </style>\n  <h2 id=\"bookshop-heading-83\">Counter pickup reservation</h2>\n  <p class=\"lead\">Enter your email and the day you plan to stop by the bookshop.</p>\n  <form action=\"/reserve\" method=\"post\">\n    <div class=\"row\">\n      <div class=\"field\">\n        <label for=\"bookshop-email-83\">Email</label>\n        <input id=\"bookshop-email-83\" name=\"email\" type=\"email\" autocomplete=\"email\" required aria-describedby=\"bookshop-email-hint-83\" />\n        <p id=\"bookshop-email-hint-83\" class=\"hint\">Confirmation arrives within an hour.</p>\n      </div>\n      <div class=\"field\">\n        <label for=\"bookshop-pickup-83\">Pickup date</label>\n        <input id=\"bookshop-pickup-83\" name=\"pickup_date\" type=\"date\" required aria-describedby=\"bookshop-pickup-hint-83\" />\n        <p id=\"bookshop-pickup-hint-83\" class=\"hint\">Held for 72 hours from this date.</p>\n      </div>\n    </div>\n    <div class=\"field\">\n      <label for=\"bookshop-notes-83\">Title or shelf note (optional)</label>\n      <textarea id=\"bookshop-notes-83\" name=\"notes\" rows=\"2\"></textarea>\n    </div>\n    <div class=\"footer\">\n      <p class=\"status\" aria-live=\"polite\">No prepayment required at reservation.</p>\n      <button type=\"submit\">Hold my copy</button>\n    </div>\n  </form>\n</section>"}, "order": ["without", "with"], "blind": "B pairs a responsive two-column form layout, 