{"id": "web0", "category": "web", "seed": 47, "skill": "frontend/frontend-design", "model": "Gemini 4 Hydrogen", "inputHash": "3cb7bbbbcec2e7b3efa4e16e79740a3341373e4e3e1a670c968e10cb4f064562", "outputs": {"without": "<section class=\"bookshop-reservation\" aria-labelledby=\"bookshop-reservation-heading\">\n  <style>\n    .bookshop-reservation {\n      max-width: 36rem;\n      margin: 2rem auto;\n      padding: 2rem;\n      background: #faf7f2;\n      color: #1f1b16;\n      border: 1px solid #ded5c7;\n      border-radius: 0.75rem;\n      font-family: Georgia, \"Times New Roman\", serif;\n      line-height: 1.5;\n    }\n    .bookshop-reservation__header {\n      margin-bottom: 1.5rem;\n      border-bottom: 1px solid #e6dfd3;\n      padding-bottom: 1rem;\n    }\n    .bookshop-reservation__title {\n      margin: 0 0 0.35rem;\n      font-size: 1.75rem;\n      line-height: 1.2;\n      color: #181410;\n    }\n    .bookshop-reservation__subtitle {\n      margin: 0;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 0.95rem;\n      color: #574f45;\n    }\n    .bookshop-reservation__fieldset {\n      margin: 0 0 1.5rem;\n      padding: 0;\n      border: 0;\n    }\n    .bookshop-reservation__legend {\n      margin-bottom: 0.85rem;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 0.85rem;\n      font-weight: 700;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n      color: #6b4c2f;\n    }\n    .bookshop-reservation__field {\n      margin-bottom: 1.1rem;\n    }\n    .bookshop-reservation__label {\n      display: block;\n      margin-bottom: 0.35rem;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 0.95rem;\n      font-weight: 600;\n      color: #1f1b16;\n    }\n    .bookshop-reservation__required {\n      color: #8f2d1b;\n    }\n    .bookshop-reservation__input,\n    .bookshop-reservation__select,\n    .bookshop-reservation__textarea {\n      box-sizing: border-box;\n      width: 100%;\n      padding: 0.65rem 0.75rem;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 1rem;\n      color: #1f1b16;\n      background: #ffffff;\n      border: 1px solid #8c7f70;\n      border-radius: 0.4rem;\n    }\n    .bookshop-reservation__input:focus,\n    .bookshop-reservation__select:focus,\n    .bookshop-reservation__textarea:focus {\n      outline: 3px solid #2b5b84;\n      outline-offset: 2px;\n      border-color: #2b5b84;\n    }\n    .bookshop-reservation__hint {\n      margin: 0.35rem 0 0;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 0.85rem;\n      color: #574f45;\n    }\n    .bookshop-reservation__actions {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 1rem;\n    }\n    .bookshop-reservation__submit {\n      padding: 0.75rem 1.4rem;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 1rem;\n      font-weight: 600;\n      color: #ffffff;\n      background: #2f4f3e;\n      border: 2px solid #2f4f3e;\n      border-radius: 0.4rem;\n      cursor: pointer;\n    }\n    .bookshop-reservation__submit:hover {\n      background: #243e30;\n      border-color: #243e30;\n    }\n    .bookshop-reservation__submit:focus {\n      outline: 3px solid #2b5b84;\n      outline-offset: 2px;\n    }\n    .bookshop-reservation__status {\n      margin: 0;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 0.9rem;\n      color: #2f4f3e;\n    }\n  </style>\n\n  <header class=\"bookshop-reservation__header\">\n    <h2 id=\"bookshop-reservation-heading\" class=\"bookshop-reservation__title\">Reserve a Book for In-Shop Pickup</h2>\n    <p id=\"bookshop-reservation-intro\" class=\"bookshop-reservation__subtitle\">\n      Hold a title at our independent bookshop desk. Fields marked with <span aria-hidden=\"true\">*</span><span class=\"bookshop-reservation__required\"> (required)</span> are needed to confirm your hold.\n    </p>\n  </header>\n\n  <form class=\"bookshop-reservation__form\" action=\"/reservations\" method=\"post\" aria-describedby=\"bookshop-reservation-intro\">\n    <fieldset class=\"bookshop-reservation__fieldset\">\n      <legend class=\"bookshop-reservation__legend\">Book Details</legend>\n\n      <div class=\"bookshop-reservation__field\">\n        <label class=\"bookshop-reservation__label\" for=\"reservation-book-title\">\n          Book title or ISBN <span class=\"bookshop-reservation__required\" aria-hidden=\"true\">*</span>\n        </label>\n        <input\n          class=\"bookshop-reservation__input\"\n          id=\"reservation-book-title\"\n          name=\"book_title\"\n          type=\"text\"\n          required\n          aria-describedby=\"reservation-book-title-hint\"\n          placeholder=\"e.g., Piranesi or 9781635575637\"\n        />\n        <p id=\"reservation-book-title-hint\" class=\"bookshop-reservation__hint\">\n          Enter the full title or 13-digit ISBN so our booksellers can pull the right edition.\n        </p>\n      </div>\n\n      <div class=\"bookshop-reservation__field\">\n        <label class=\"bookshop-reservation__label\" for=\"reservation-edition\">\n          Preferred format\n        </label>\n        <select class=\"bookshop-reservation__select\" id=\"reservation-edition\" name=\"edition_format\">\n          <option value=\"any\">Any available in-stock edition</option>\n          <option value=\"hardcover\">Hardcover</option>\n          <option value=\"paperback\">Paperback</option>\n          <option value=\"used\">Quality secondhand copy</option>\n        </select>\n      </div>\n    </fieldset>\n\n    <fieldset class=\"bookshop-reservation__fieldset\">\n      <legend class=\"bookshop-reservation__legend\">Reader &amp; Pickup Schedule</legend>\n\n      <div class=\"bookshop-reservation__field\">\n        <label class=\"bookshop-reservation__label\" for=\"reservation-name\">\n          Your name <span class=\"bookshop-reservation__required\" aria-hidden=\"true\">*</span>\n        </label>\n        <input\n          class=\"bookshop-reservation__input\"\n          id=\"reservation-name\"\n          name=\"reader_name\"\n          type=\"text\"\n          autocomplete=\"name\"\n          required\n        />\n      </div>\n\n      <div class=\"bookshop-reservation__field\">\n        <label class=\"bookshop-reservation__label\" for=\"reservation-email\">\n          Email address <span class=\"bookshop-reservation__required\" aria-hidden=\"true\">*</span>\n        </label>\n        <input\n          class=\"bookshop-reservation__input\"\n          id=\"reservation-email\"\n          name=\"email\"\n          type=\"email\"\n          autocomplete=\"email\"\n          inputmode=\"email\"\n          required\n          aria-describedby=\"reservation-email-hint\"\n          placeholder=\"reader@example.com\"\n        />\n        <p id=\"reservation-email-hint\" class=\"bookshop-reservation__hint\">\n          We will send one confirmation when your book is shelved at the pickup counter.\n        </p>\n      </div>\n\n      <div class=\"bookshop-reservation__field\">\n        <label class=\"bookshop-reservation__label\" for=\"reservation-pickup-date\">\n          Pickup date <span class=\"bookshop-reservation__required\" aria-hidden=\"true\">*</span>\n        </label>\n        <input\n          class=\"bookshop-reservation__input\"\n          id=\"reservation-pickup-date\"\n          name=\"pickup_date\"\n          type=\"date\"\n          required\n          aria-describedby=\"reservation-pickup-date-hint\"\n        />\n        <p id=\"reservation-pickup-date-hint\" class=\"bookshop-reservation__hint\">\n          Open Tuesday through Sunday, 10:00 AM to 7:00 PM. We hold reserved books for 3 days past your chosen date.\n        </p>\n      </div>\n\n      <div class=\"bookshop-reservation__field\">\n        <label class=\"bookshop-reservation__label\" for=\"reservation-notes\">\n          Notes for the bookseller (optional)\n        </label>\n        <textarea\n          class=\"bookshop-reservation__textarea\"\n          id=\"reservation-notes\"\n          name=\"notes\"\n          rows=\"3\"\n          aria-describedby=\"reservation-notes-hint\"\n        ></textarea>\n        <p id=\"reservation-notes-hint\" class=\"bookshop-reservation__hint\">\n          Let us know if you need gift wrapping, accessibility accommodations at pickup, or a specific translator.\n        </p>\n      </div>\n    </fieldset>\n\n    <div class=\"bookshop-reservation__actions\">\n      <button class=\"bookshop-reservation__submit\" type=\"submit\">Reserve for Pickup</button>\n      <p id=\"reservation-status\" class=\"bookshop-reservation__status\" role=\"status\" aria-live=\"polite\"></p>\n    </div>\n  </form>\n</section>", "with": "<section class=\"bookshop-split-47\" aria-labelledby=\"bookshop-heading-47\">\n  <style>\n    .bookshop-split-47 {\n      max-width: 48rem;\n      margin: 0 auto;\n      padding: 1.5rem;\n      background: #fafafa;\n      border: 1px solid #d4d4d8;\n      border-radius: 0.5rem;\n      color: #18181b;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.5;\n      display: grid;\n      gap: 1.5rem;\n    }\n    @media (min-width: 42rem) {\n      .bookshop-split-47 {\n        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);\n        padding: 2rem;\n        gap: 2rem;\n      }\n    }\n    .bookshop-split-47 .aside h2 {\n      margin: 0 0 0.75rem;\n      font-size: 1.375rem;\n      font-weight: 700;\n      color: #18181b;\n    }\n    .bookshop-split-47 .aside p {\n      margin: 0 0 0.75rem;\n      font-size: 0.9375rem;\n      color: #3f3f46;\n    }\n    .bookshop-split-47 .aside ul {\n      margin: 0;\n      padding-left: 1.125rem;\n      font-size: 0.875rem;\n      color: #52525b;\n    }\n    .bookshop-split-47 fieldset {\n      margin: 0;\n      padding: 0;\n      border: 0;\n    }\n    .bookshop-split-47 legend {\n      margin-bottom: 1rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #3f3f46;\n    }\n    .bookshop-split-47 .field {\n      margin-bottom: 1rem;\n    }\n    .bookshop-split-47 label {\n      display: block;\n      margin-bottom: 0.375rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #27272a;\n    }\n    .bookshop-split-47 input,\n    .bookshop-split-47 select {\n      display: block;\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.5rem 0.75rem;\n      box-sizing: border-box;\n      border: 1px solid #71717a;\n      border-radius: 0.375rem;\n      background: #ffffff;\n      color: #18181b;\n      font: inherit;\n      font-size: 1rem;\n    }\n    .bookshop-split-47 input:focus-visible,\n    .bookshop-split-47 select:focus-visible,\n    .bookshop-split-47 button:focus-visible {\n      outline: 2px solid #18181b;\n      outline-offset: 2px;\n    }\n    .bookshop-split-47 .hint {\n      margin: 0.375rem 0 0;\n      font-size: 0.8125rem;\n      color: #52525b;\n    }\n    .bookshop-split-47 .actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.75rem;\n      margin-top: 1.5rem;\n    }\n    .bookshop-split-47 button[type=\"submit\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1.25rem;\n      border: 1px solid #18181b;\n      border-radius: 0.375rem;\n      background: #18181b;\n      color: #ffffff;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    .bookshop-split-47 button[type=\"reset\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1rem;\n      border: 1px solid #71717a;\n      border-radius: 0.375rem;\n      background: transparent;\n      color: #18181b;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 500;\n      cursor: pointer;\n    }\n  </style>\n  <div class=\"aside\">\n    <h2 id=\"bookshop-heading-47\">Bookshop hold request</h2>\n    <p>Reserve an in-stock volume from our shelf before you visit.</p>\n    <ul>\n      <li>Pay in person when you collect your order.</li>\n      <li>Same-day holds available before 16:00.</li>\n    </ul>\n  </div>\n  <form action=\"/bookshop/reserve\" method=\"post\">\n    <fieldset>\n      <legend>Reservation details</legend>\n      <div class=\"field\">\n        <label for=\"bookshop-email-47\">Email for hold notice</label>\n        <input id=\"bookshop-email-47\" name=\"email\" type=\"email\" autocomplete=\"email\" required aria-describedby=\"bookshop-email-hint-47\" />\n        <p id=\"bookshop-email-hint-47\" class=\"hint\">Used only for pickup confirmation.</p>\n      </div>\n      <div class=\"field\">\n        <label for=\"bookshop-pickup-47\">Preferred pickup date</label>\n        <input id=\"bookshop-pickup-47\" name=\"pickup_date\" type=\"date\" required aria-describedby=\"bookshop-pickup-hint-47\" />\n        <p id=\"bookshop-pickup-hint-47\" class=\"hint\">Choose any day Tuesday through Sunday.</p>\n      </div>\n      <div class=\"field\">\n        <label for=\"bookshop-edition-47\">Edition preference</label>\n        <select id=\"bookshop-edition-47\" name=\"edition\">\n          <option value=\"either\">Either paperback or hardcover</option>\n          <option value=\"paperback\">Paperback</option>\n          <option value=\"hardcover\">Hardcover</option>\n        </select>\n      </div>\n    </fieldset>\n    <div class=\"actions\">\n      <button type=\"submit\">Request hold</button>\n      <button type=\"reset\">Clear fields</button>\n    </div>\n  </form>\n</section>"}, "order": ["with", "without"], "blind": "B provides a complete, usable bookshop reservation form with book title/ISBN, edition, reader name, email, pickup date, notes, and a live status region, whereas A omits any field to specify which book to reserve.", "checks": {"without": 2, "with": 2}, "delta": -1}
