n      <div class=\"photo-contact__field\">\n        <label class=\"photo-contact__label\" for=\"pc-name\">\n          Full name\n          <span class=\"photo-contact__req\" aria-hidden=\"true\">*</span>\n          <span class=\"photo-contact__sr-only\">(required)</span>\n        </label>\n        <input\n          class=\"photo-contact__input\"\n          id=\"pc-name\"\n          name=\"name\"\n          type=\"text\"\n          autocomplete=\"name\"\n          required\n        >\n      </div>\n\n      <div class=\"photo-contact__field\">\n        <label class=\"photo-contact__label\" for=\"pc-email\">\n          Email address\n          <span class=\"photo-contact__req\" aria-hidden=\"true\">*</span>\n          <span class=\"photo-contact__sr-only\">(required)</span>\n        </label>\n        <input\n          class=\"photo-contact__input\"\n          id=\"pc-email\"\n          name=\"email\"\n          type=\"email\"\n          autocomplete=\"email\"\n          inputmode=\"email\"\n          required\n          aria-describedby=\"pc-email-hint\"\n        >\n        <p id=\"pc-email-hint\" class=\"photo-contact__hint\">\n          Used solely to reply to your booking inquiry.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"photo-contact__row\">\n      <div class=\"photo-contact__field\">\n        <label class=\"photo-contact__label\" for=\"pc-session\">Session type</label>\n        <select class=\"photo-contact__select\" id=\"pc-session\" name=\"session_type\">\n          <option value=\"editorial\">Editorial &amp; Feature</option>\n          <option value=\"portrait\">Portrait Session</option>\n          <option value=\"commercial\">Commercial / Brand</option>\n          <option value=\"event\">Documentary &amp; Events</option>\n          <option value=\"print\">Print &amp; Licensing</option>\n        </select>\n      </div>\n\n      <div class=\"photo-contact__field\">\n        <label class=\"photo-contact__label\" for=\"pc-date\">Target date or 