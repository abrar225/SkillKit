{"id": "web1", "category": "web", "seed": 31, "skill": "frontend/frontend-design", "model": "Gemini 4 Hydrogen", "inputHash": "e7843fd4af14e7eeeb5827c442db68f8401cf54f11189ce776ee5d0068c25c59", "outputs": {"without": "<section class=\"photo-contact\" aria-labelledby=\"photo-contact-heading\">\n  <style>\n    .photo-contact {\n      --pc-bg: #faf9f7;\n      --pc-surface: #ffffff;\n      --pc-ink: #161616;\n      --pc-muted: #525252;\n      --pc-border: #d4d1cb;\n      --pc-border-strong: #161616;\n      --pc-accent: #161616;\n      --pc-accent-ink: #ffffff;\n      --pc-focus: #0f4c81;\n      --pc-error: #b42318;\n      box-sizing: border-box;\n      max-width: 40rem;\n      margin: 0 auto;\n      padding: clamp(1.75rem, 4vw, 3rem);\n      background: var(--pc-bg);\n      color: var(--pc-ink);\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.5;\n      border: 1px solid var(--pc-border);\n    }\n\n    .photo-contact *,\n    .photo-contact *::before,\n    .photo-contact *::after {\n      box-sizing: inherit;\n    }\n\n    .photo-contact__eyebrow {\n      margin: 0 0 0.5rem;\n      font-size: 0.75rem;\n      font-weight: 600;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      color: var(--pc-muted);\n    }\n\n    .photo-contact__heading {\n      margin: 0 0 0.75rem;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(1.75rem, 3vw, 2.25rem);\n      font-weight: 400;\n      line-height: 1.15;\n      letter-spacing: -0.01em;\n    }\n\n    .photo-contact__intro {\n      margin: 0 0 2rem;\n      font-size: 0.95rem;\n      color: var(--pc-muted);\n    }\n\n    .photo-contact__form {\n      display: grid;\n      gap: 1.25rem;\n    }\n\n    .photo-contact__row {\n      display: grid;\n      gap: 1.25rem;\n    }\n\n    @media (min-width: 34rem) {\n      .photo-contact__row {\n        grid-template-columns: 1fr 1fr;\n      }\n    }\n\n    .photo-contact__field {\n      display: flex;\n      flex-direction: column;\n      gap: 0.4rem;\n    }\n\n    .photo-contact__label {\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: var(--pc-ink);\n    }\n\n    .photo-contact__req {\n      color: var(--pc-error);\n      margin-left: 0.15rem;\n    }\n\n    .photo-contact__input,\n    .photo-contact__select,\n    .photo-contact__textarea {\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.65rem 0.85rem;\n      background: var(--pc-surface);\n      color: var(--pc-ink);\n      border: 1px solid var(--pc-border);\n      border-radius: 2px;\n      font: inherit;\n      font-size: 1rem;\n      transition: border-color 0.15s ease;\n    }\n\n    .photo-contact__textarea {\n      min-height: 7.5rem;\n      resize: vertical;\n    }\n\n    .photo-contact__input:hover,\n    .photo-contact__select:hover,\n    .photo-contact__textarea:hover {\n      border-color: var(--pc-border-strong);\n    }\n\n    .photo-contact__input:focus-visible,\n    .photo-contact__select:focus-visible,\n    .photo-contact__textarea:focus-visible,\n    .photo-contact__checkbox:focus-visible,\n    .photo-contact__submit:focus-visible {\n      outline: 2px solid var(--pc-focus);\n      outline-offset: 2px;\n    }\n\n    .photo-contact__hint {\n      margin: 0;\n      font-size: 0.8125rem;\n      color: var(--pc-muted);\n    }\n\n    .photo-contact__consent {\n      display: flex;\n      align-items: flex-start;\n      gap: 0.75rem;\n      padding: 0.9rem 1rem;\n      background: var(--pc-surface);\n      border: 1px solid var(--pc-border);\n      border-radius: 2px;\n    }\n\n    .photo-contact__checkbox {\n      flex: 0 0 auto;\n      width: 1.25rem;\n      height: 1.25rem;\n      margin: 0.15rem 0 0;\n      accent-color: var(--pc-accent);\n      cursor: pointer;\n    }\n\n    .photo-contact__consent-body {\n      display: flex;\n      flex-direction: column;\n      gap: 0.25rem;\n    }\n\n    .photo-contact__consent-label {\n      font-size: 0.87