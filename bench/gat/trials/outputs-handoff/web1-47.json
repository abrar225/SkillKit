isplay: grid;\n      gap: 1.5rem;\n    }\n    @media (min-width: 42rem) {\n      .photo-split-47 {\n        grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);\n        padding: 2rem;\n        gap: 2rem;\n      }\n    }\n    .photo-split-47 .sidebar h2 {\n      margin: 0 0 0.5rem;\n      font-size: 1.375rem;\n      font-weight: 700;\n      color: #18181b;\n    }\n    .photo-split-47 .sidebar p {\n      margin: 0 0 0.75rem;\n      font-size: 0.9375rem;\n      color: #3f3f46;\n    }\n    .photo-split-47 fieldset {\n      margin: 0;\n      padding: 0;\n      border: 0;\n    }\n    .photo-split-47 legend {\n      margin-bottom: 1rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #3f3f46;\n    }\n    .photo-split-47 .field {\n      margin-bottom: 1rem;\n    }\n    .photo-split-47 label.block-label {\n      display: block;\n      margin-bottom: 0.375rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #27272a;\n    }\n    .photo-split-47 input[type=\"text\"],\n    .photo-split-47 input[type=\"email\"],\n    .photo-split-47 select {\n      display: block;\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.5rem 0.75rem;\n      box-sizing: border-box;\n      border: 1px solid #71717a;\n      border-radius: 0.375rem;\n      background: #ffffff;\n      color: #18181b;\n      font: inherit;\n      font-size: 1rem;\n    }\n    .photo-split-47 .consent-box {\n      display: flex;\n      align-items: flex-start;\n      gap: 0.75rem;\n      padding: 0.75rem;\n      border: 1px solid #d4d4d8;\n      border-radius: 0.375rem;\n      background: #ffffff;\n    }\n    .photo-split-47 input[type=\"checkbox\"] {\n      flex-shrink: 0;\n      width: 1.25rem;\n      height: 1.25rem;\n      margin-top: 0.125rem;\n      accent-color: #18181b;\n    }\n    .photo-split-47 .consent-box label {\n      font-size: 0.875rem;\n      color: #27272a;\n      cursor: pointer;\n    }\n    .photo-split-47 input:focus-visible,\n    .photo-split-47 select:focus-visible,\n    .photo-split-47 button:focus-visible {\n      outline: 2px solid #18181b;\n      outline-offset: 2px;\n    }\n    .photo-split-47 .actions {\n      margin-top: 1.25rem;\n    }\n    .photo-split-47 button[type=\"submit\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1.5rem;\n      border: 1px solid #18181b;\n      border-radius: 0.375rem;\n      background: #18181b;\n      color: #ffffff;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n  </style>\n  <div class=\"sidebar\">\n    <h2 id=\"photo-heading-47\">Book a commission</h2>\n    <p>Available for documentary assignments, artist portraits, and architectural studies.</p>\n    <p>Based in Chicago; open to travel.</p>\n  </div>\n  <form action=\"/studio-contact\" method=\"post\">\n    <fieldset>\n      <legend>Your contact details</legend>\n      <div class=\"field\">\n        <label class=\"block-label\" for=\"photo-name-47\">Your name</label>\n        <input id=\"photo-name-47\" name=\"name\" type=\"text\" autocomplete=\"name\" required />\n      </div>\n      <div class=\"field\">\n        <label class=\"block-label\" for=\"photo-email-47\">Email</label>\n        <input id=\"photo-email-47\" name=\"email\" type=\"email\" autocomplete=\"email\" required />\n      </div>\n      <div class=\"field\">\n        <label class=\"block-label\" for=\"photo-type-47\">Session type</label>\n        <select id=\"photo-type-47\" name=\"session_type\">\n          <option value=\"portrait\">Portrait session</option>\n          <option value=\"editorial\">Editorial assignment</option>\n          <option value=\"event\">Exhibition or event coverage</option>\n        </select>\n      </div>\n      <div class=\"consent-box\">\n        <input id=\"photo-consent-47\" name=\"consent\" type=\"checkbox\" required />\n        <label for=\"photo-consent-47\">I consent to storing this inquiry so the photographer can respond by email.</label>\n      