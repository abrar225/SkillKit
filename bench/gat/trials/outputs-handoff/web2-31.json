ity-archive-search__input::placeholder {\n      color: var(--archive-muted);\n      opacity: 1;\n    }\n\n    .community-archive-search__submit {\n      min-height: 2.75rem;\n      padding: 0.625rem 1.25rem;\n      font: inherit;\n      font-size: 1rem;\n      font-weight: 600;\n      color: #ffffff;\n      background-color: var(--archive-accent);\n      border: 1.5px solid transparent;\n      border-radius: 0.5rem;\n      cursor: pointer;\n    }\n\n    .community-archive-search__submit:hover {\n      background-color: var(--archive-accent-hover);\n    }\n\n    .community-archive-search__input:focus-visible,\n    .community-archive-search__submit:focus-visible {\n      outline: 3px solid var(--archive-focus);\n      outline-offset: 2px;\n    }\n\n    .community-archive-search__hint {\n      margin: 0.25rem 0 0;\n      font-size: 0.875rem;\n      line-height: 1.4;\n      color: var(--archive-muted);\n    }\n  </style>\n\n  <h2 id=\"archive-search-title\" class=\"community-archive-search__title\">\n    Community Archive\n  </h2>\n  <p class=\"community-archive-search__intro\">\n    Explore neighborhood photographs, oral histories, flyers, and recorded memories preserved by local contributors.\n  </p>\n\n  <form\n    class=\"community-archive-search__form\"\n    action=\"/archive/search\"\n    method=\"get\"\n    role=\"search\"\n    aria-labelledby=\"archive-search-title\"\n  >\n    <label for=\"archive-search-query\" class=\"community-archive-search__label\">\n      Search the community archive\n    </label>\n    <div class=\"community-archive-search__controls\">\n      <input\n        id=\"archive-search-query\"\n        class=\"community-archive-search__input\"\n        name=\"q\"\n        type=\"search\"\n        inputmode=\"search\"\n        autocomplete=\"off\"\n        placeholder=\"e.g., Oak Street block party, 1984\"\n        aria-describedby=\"archive-search-hint\"\n        required\n      >\n      <button type=\"submit\" class=\"community-archive-search__submit\">\n        Search archive\n      </button>\n    </div>\n    <p id=\"archive-search-hint\" class=\"community-archive-search__hint\">\n      Enter keywords, contributor names, street names, or years.\n    </p>\n  </form>\n</section>", "with": "<section class=\"archive-card-31\" aria-labelledby=\"archive-heading-31\">\n  <style>\n    .archive-card-31 {\n      max-width: 34rem;\n      margin: 0 auto;\n      padding: 1.5rem;\n      background: #ffffff;\n      border: 1px solid #d4d4d8;\n      border-radius: 0.5rem;\n      color: #18181b;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.5;\n    }\n    .archive-card-31 h2 {\n      margin: 0 0 0.5rem;\n      font-size: 1.375rem;\n      font-weight: 700;\n      color: #18181b;\n    }\n    .archive-card-31 .intro {\n      margin: 0 0 1.25rem;\n      font-size: 0.9375rem;\n      color: #3f3f46;\n    }\n    .archive-card-31 label {\n      display: block;\n      margin-bottom: 0.375rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #27272a;\n    }\n    .archive-card-31 input[type=\"search\"] {\n      display: block;\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.625rem 0.75rem;\n      box-sizing: border-box;\n      border: 1px solid #71717a;\n      border-radius: 0.375rem;\n      background: #ffffff;\n      color: #18181b;\n      font: inherit;\n      font-size: 1rem;\n    }\n    .archive-card-31 .hint {\n      margin: 0.375rem 0 1.25rem;\n      font-size: 0.8125rem;\n      color: #52525b;\n    }\n    .archive-card-31 input:focus-visible,\n    .archive-card-31 button:focus-visible {\n      outline: 2px solid #18181b;\n      outline-offset: 2px;\n    }\n    .archive-card-31 button[type=\"submit\"] {\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.75rem 1.25rem;\n      border: 1px solid #18181b;\n      border-radius: 0.375rem;\n      background: #18181b;\n      color: #ffffff;\n      font: inherit;\n    