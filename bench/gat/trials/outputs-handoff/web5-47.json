eight: 700;\n      color: #0f172a;\n    }\n    .cinema-split-47 .aside p {\n      margin: 0;\n      font-size: 0.9375rem;\n      color: #334155;\n    }\n    .cinema-split-47 fieldset {\n      margin: 0;\n      padding: 0;\n      border: 0;\n    }\n    .cinema-split-47 legend {\n      margin-bottom: 1rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #334155;\n    }\n    .cinema-split-47 .field {\n      margin-bottom: 1rem;\n    }\n    .cinema-split-47 label {\n      display: block;\n      margin-bottom: 0.375rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #1e293b;\n    }\n    .cinema-split-47 input,\n    .cinema-split-47 select {\n      display: block;\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.5rem 0.75rem;\n      box-sizing: border-box;\n      border: 1px solid #64748b;\n      border-radius: 0.375rem;\n      background: #ffffff;\n      color: #0f172a;\n      font: inherit;\n      font-size: 1rem;\n    }\n    .cinema-split-47 input:focus-visible,\n    .cinema-split-47 select:focus-visible,\n    .cinema-split-47 button:focus-visible {\n      outline: 2px solid #0f172a;\n      outline-offset: 2px;\n    }\n    .cinema-split-47 .actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.75rem;\n      margin-top: 1.25rem;\n    }\n    .cinema-split-47 button[type=\"submit\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1.25rem;\n      border: 1px solid #0f172a;\n      border-radius: 0.375rem;\n      background: #0f172a;\n      color: #ffffff;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    .cinema-split-47 button[type=\"reset\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1rem;\n      border: 1px solid #64748b;\n      border-radius: 0.375rem;\n      background: #ffffff;\n      color: #0f172a;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 500;\n      cursor: pointer;\n    }\n  </style>\n  <div class=\"aside\">\n    <h2 id=\"cinema-heading-47\">Showtime calendar</h2>\n    <p>Filter repertory and first-run cinema listings by date and time of day.</p>\n  </div>\n  <form action=\"/cinema/schedule\" method=\"get\">\n    <fieldset>\n      <legend>Filter options</legend>\n      <div class=\"field\">\n        <label for=\"cinema-date-47\">Screening date</label>\n        <input id=\"cinema-date-47\" name=\"date\" type=\"date\" />\n      </div>\n      <div class=\"field\">\n        <label for=\"cinema-time-47\">Time of day</label>\n        <select id=\"cinema-time-47\" name=\"window\">\n          <option value=\"all\">All showtimes</option>\n          <option value=\"matinee\">Matinee (before 17:00)</option>\n          <option value=\"evening\">Evening (17:00 and later)</option>\n        </select>\n      </div>\n    </fieldset>\n    <div class=\"actions\">\n      <button type=\"submit\">Apply filter</button>\n      <button type=\"reset\">Clear filter</button>\n    </div>\n  </form>\n</section>"}, "order": ["without", "with"], "blind": "B provides a responsive two-column layout with scoped CSS, 44px touch targets, and focus-visible indicators for the date filter and reset button, whereas A is unstyled HTML.", "checks": {"without": 2, "with": 2}, "delta": 1}
