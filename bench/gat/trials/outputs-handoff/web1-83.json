red />\n      </div>\n      <div>\n        <label class=\"top\" for=\"photo-window-83\">Target timeframe (optional)</label>\n        <input id=\"photo-window-83\" name=\"timeframe\" type=\"text\" placeholder=\"e.g. October\" />\n      </div>\n    </div>\n    <div class=\"msg\">\n      <label class=\"top\" for=\"photo-message-83\">Note</label>\n      <textarea id=\"photo-message-83\" name=\"note\" rows=\"3\" required></textarea>\n    </div>\n    <div class=\"consent-line\">\n      <input id=\"photo-consent-83\" name=\"privacy_consent\" type=\"checkbox\" required aria-describedby=\"photo-consent-help-83\" />\n      <label for=\"photo-consent-83\">Yes, use my email solely to reply to this studio message.</label>\n    </div>\n    <div class=\"bar\">\n      <p id=\"photo-consent-help-83\" class=\"status\" aria-live=\"polite\">Consent is required before sending.</p>\n      <button type=\"submit\">Send message</button>\n    </div>\n  </form>\n</section>"}, "order": ["without", "with"], "blind": "B delivers responsive styling, 44px touch targets, focus-visible outlines, and a clearly styled consent checkbox with live status text, whereas A lacks any CSS styling.", "checks": {"without": 2, "with": 2}, "delta": 1}
