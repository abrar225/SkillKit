-session-type\" name=\"session_type\">\n        <option value=\"\">Select a session type</option>\n        <option value=\"editorial\">Editorial &amp; Lookbook</option>\n        <option value=\"portrait\">Portrait Session</option>\n        <option value=\"commercial\">Commercial &amp; Brand Campaign</option>\n        <option value=\"event\">Wedding &amp; Private Event</option>\n        <option value=\"prints\">Fine Art Prints &amp; Licensing</option>\n      </select>\n    </div>\n\n    <div class=\"form-field\">\n      <label for=\"contact-date\">Preferred date or timeframe</label>\n      <input\n        id=\"contact-date\"\n        name=\"preferred_date\"\n        type=\"text\"\n        aria-describedby=\"contact-date-hint\"\n        placeholder=\"e.g., October 14 or mid-November\"\n      />\n      <p id=\"contact-date-hint\" class=\"field-hint\">\n        Optional. Approximate dates or seasons are helpful for scheduling.\n      </p>\n    </div>\n\n    <div class=\"form-field\">\n      <label for=\"contact-message\">\n        Project details <span class=\"required-indicator\" aria-hidden=\"true\">*</span>\n      </label>\n      <textarea\n        id=\"contact-message\"\n        name=\"message\"\n        rows=\"5\"\n        required\n        aria-required=\"true\"\n        aria-describedby=\"contact-message-hint\"\n        placeholder=\"Tell me about the location, creative direction, deliverables, and timeline.\"\n      ></textarea>\n      <p id=\"contact-message-hint\" class=\"field-hint\">\n        Include location, shoot scope, and any licensing needs.\n      </p>\n    </div>\n\n    <fieldset class=\"form-consent\">\n      <legend>Privacy &amp; communication consent</legend>\n      <div class=\"checkbox-field\">\n        <input\n          id=\"contact-consent\"\n          name=\"consent\"\n          type=\"checkbox\"\n          value=\"accepted\"\n          required\n          aria-required=\"true\"\n          aria-describedby=\"contact-consent-hint\"\n        />