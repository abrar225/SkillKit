{"id": "web2", "category": "web", "seed": 47, "skill": "frontend/frontend-design", "model": "Gemini 4 Hydrogen", "inputHash": "bfdcc8b45dc478bb482f5b494680b3ae2e3b294ee4a3e7b6318f71435f9faac3", "outputs": {"without": "<section class=\"archive-search\" aria-labelledby=\"archive-search-heading\">\n  <style>\n    .archive-search {\n      --as-bg: #f8f7f4;\n      --as-surface: #ffffff;\n      --as-text: #1c1b18;\n      --as-muted: #57534e;\n      --as-border: #78716c;\n      --as-accent: #1d4ed8;\n      --as-accent-hover: #1e40af;\n      --as-focus: #0f172a;\n      max-width: 42rem;\n      padding: 1.5rem;\n      background-color: var(--as-bg);\n      color: var(--as-text);\n      border: 1px solid #d6d3d1;\n      border-radius: 0.5rem;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    }\n\n    .archive-search__heading {\n      margin: 0 0 0.375rem;\n      font-size: 1.25rem;\n      line-height: 1.3;\n      font-weight: 600;\n    }\n\n    .archive-search__hint {\n      margin: 0 0 1rem;\n      font-size: 0.9375rem;\n      line-height: 1.5;\n      color: var(--as-muted);\n    }\n\n    .archive-search__form {\n      display: flex;\n      flex-direction: column;\n      gap: 0.5rem;\n    }\n\n    .archive-search__label {\n      font-size: 0.9375rem;\n      font-weight: 600;\n      line-height: 1.4;\n    }\n\n    .archive-search__controls {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.75rem;\n      align-items: stretch;\n    }\n\n    .archive-search__input {\n      flex: 1 1 16rem;\n      min-height: 2.75rem;\n      padding: 0.625rem 0.875rem;\n      font-size: 1rem;\n      line-height: 1.5;\n      color: var(--as-text);\n      background-color: var(--as-surface);\n      border: 2px solid var(--as-border);\n      border-radius: 0.375rem;\n    }\n\n    .archive-search__input:focus-visible {\n      outline: 3px solid var(--as-focus);\n      outline-offset: 2px;\n      border-color: var(--as-accent);\n    }\n\n    .archive-search__submit {\n      min-height: 2.75rem;\n      padding: 0.625rem 1.25rem;\n      font-size: 1rem;\n      font-weight: 600;\n      line-height: 1.5;\n      color: #ffffff;\n      background-color: var(--as-accent);\n      border: 2px solid transparent;\n      border-radius: 0.375rem;\n      cursor: pointer;\n    }\n\n    .archive-search__submit:hover {\n      background-color: var(--as-accent-hover);\n    }\n\n    .archive-search__submit:focus-visible {\n      outline: 3px solid var(--as-focus);\n      outline-offset: 2px;\n    }\n  </style>\n\n  <h2 id=\"archive-search-heading\" class=\"archive-search__heading\">Community Archive Search</h2>\n  <p id=\"archive-search-hint\" class=\"archive-search__hint\">\n    Search archived records by title, contributor name, year, or subject keyword.\n  </p>\n\n  <form class=\"archive-search__form\" role=\"search\" aria-labelledby=\"archive-search-heading\" action=\"/archive/search\" method=\"get\">\n    <label class=\"archive-search__label\" for=\"archive-search-query\">\n      Search the community archive\n    </label>\n    <div class=\"archive-search__controls\">\n      <input\n        id=\"archive-search-query\"\n        class=\"archive-search__input\"\n        name=\"q\"\n        type=\"search\"\n        placeholder=\"e.g., oral history 1984\"\n        enterkeyhint=\"search\"\n        aria-describedby=\"archive-search-hint\"\n        required\n      >\n      <button class=\"archive-search__submit\" type=\"submit\">\n        Search archive\n      </button>\n    </div>\n  </form>\n</section>", "with": "<section class=\"archive-split-47\" aria-labelledby=\"archive-heading-47\">\n  <style>\n    .archive-split-47 {\n      max-width: 48rem;\n      margin: 0 auto;\n      padding: 1.5rem;\n      background: #f8fafc;\n      border: 1px solid #cbd5e1;\n      border-radius: 0.5rem;\n      color: #0f172a;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.5;\n      display: grid;\n      gap: 1.5rem;\n    }\n    @media (min-width: 42rem) {\n      .archive-split-47 {\n        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);\n        padding: 2rem;\n        gap: 2rem;\n      }\n    }\n    .archive-split-47 .aside h2 {\n      margin: 0 0 0.5rem;\n      font-size: 1.375rem;\n      font-weight: 700;\n      color: #0f172a;\n    }\n    .archive-split-47 .aside p {\n      margin: 0;\n      font-size: 0.9375rem;\n      color: #334155;\n    }\n    .archive-split-47 fieldset {\n      margin: 0;\n      padding: 0;\n      border: 0;\n    }\n    .archive-split-47 legend {\n      margin-bottom: 1rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #334155;\n    }\n    .archive-split-47 .field {\n      margin-bottom: 1rem;\n    }\n    .archive-split-47 label {\n      display: block;\n      margin-bottom: 0.375rem;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: #1e293b;\n    }\n    .archive-split-47 input,\n    .archive-split-47 select {\n      display: block;\n      width: 100%;\n      min-height: 2.75rem;\n      padding: 0.5rem 0.75rem;\n      box-sizing: border-box;\n      border: 1px solid #64748b;\n      border-radius: 0.375rem;\n      background: #ffffff;\n      color: #0f172a;\n      font: inherit;\n      font-size: 1rem;\n    }\n    .archive-split-47 input:focus-visible,\n    .archive-split-47 select:focus-visible,\n    .archive-split-47 button:focus-visible {\n      outline: 2px solid #0f172a;\n      outline-offset: 2px;\n    }\n    .archive-split-47 .actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.75rem;\n      margin-top: 1.25rem;\n    }\n    .archive-split-47 button[type=\"submit\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1.25rem;\n      border: 1px solid #0f172a;\n      border-radius: 0.375rem;\n      background: #0f172a;\n      color: #ffffff;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    .archive-split-47 button[type=\"reset\"] {\n      min-height: 2.75rem;\n      padding: 0.625rem 1rem;\n      border: 1px solid #64748b;\n      border-radius: 0.375rem;\n      background: transparent;\n      color: #0f172a;\n      font: inherit;\n      font-size: 0.9375rem;\n      font-weight: 500;\n      cursor: pointer;\n    }\n  </style>\n  <div class=\"aside\">\n    <h2 id=\"archive-heading-47\">Neighborhood records</h2>\n    <p>Search 14,000 indexed flyers, meeting minutes, and donated family albums.</p>\n  </div>\n  <form role=\"search\" action=\"/archive\" method=\"get\">\n    <fieldset>\n      <legend>Archive search parameters</legend>\n      <div class=\"field\">\n        <label for=\"archive-query-47\">Search term</label>\n        <input id=\"archive-query-47\" name=\"q\" type=\"search\" enterkeyhint=\"search\" required />\n      </div>\n      <div class=\"field\">\n        <label for=\"archive-collection-47\">Collection</label>\n        <select id=\"archive-collection-47\" name=\"collection\">\n          <option value=\"all\">All collections</option>\n          <option value=\"photos\">Photographs</option>\n          <option value=\"audio\">Oral histories</option>\n          <option value=\"print\">Print ephemera</option>\n        </select>\n      </div>\n    </fieldset>\n    <div class=\"actions\">\n      <button type=\"submit\">Search records</button>\n      <button type=\"reset\">Reset</button>\n    </div>\n  </form>\n</section>"}, "order": ["with", "without"], "blind": "B presents a cleaner responsive inline search bar with crisp borders and 3px focus-visible rings while properly naming its search landmark and linking input hints via aria-describedby.", "checks": {"without": 2, "with": 2}, "delta": -1}
